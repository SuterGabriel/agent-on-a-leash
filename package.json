{
  "name": "agent-on-a-leash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check-key": "tsx packages/backend/src/cli/checkKey.ts",
    "scenario": "tsx packages/backend/src/cli/runScenario.ts",
    "api": "tsx packages/backend/src/cli/api.ts",
    "web": "npm --prefix app-web run dev",
    "web:build": "npm --prefix app-web run build",
    "demo:tokens": "tsx packages/backend/src/cli/demoTokens.ts",
    "api-atlas": "tsx packages/backend/src/cli/apiAtlas.ts",
    "live-results": "tsx packages/backend/src/cli/liveResults.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "replay": "tsx packages/engine/src/replay.ts",
    "inspect-live": "tsx packages/backend/src/cli/inspectLive.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
