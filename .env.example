# Copy to .env and fill in. Never commit .env.
LEASH_MODE=offline
# Snapshot file so a restart keeps the leash, feed, open asks and tokens. Default data/live/state-<mode>.json; "off" disables.
# LEASH_STATE_FILE=off
LEASH_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io
TEAM_API_KEY=
# App API (npm run api). Required in live mode, optional offline.
# APP_SECRET: the app sends "Authorization: Bearer <APP_SECRET>" on every POST/PATCH/DELETE under /app/*.
APP_SECRET=
# CORS_ORIGIN: the app's dev server, e.g. http://localhost:5173 (never * in live mode).
CORS_ORIGIN=
# Voice approval: `npm run voice:agent` creates the ElevenLabs agent with this key (server-side only; the app gets the agent id).
ELEVENLABS_API_KEY=
# ELEVENLABS_LLM=gpt-4o-mini
# ELEVENLABS_VOICE_ID=
