# Copy to .env.local to run against the backend in this repo (npm run api, port 8787). Unset = mock data.
# Local dev (recommended): the app talks to its own dev server, Vite forwards /v4 to the backend and adds APP_SECRET
# there from the repo's .env (vite.config.ts). The secret never reaches the browser.
VITE_API_BASE=/v4
# Where the backend runs (default http://localhost:8787).
# API_TARGET=http://localhost:8787
# Only for a static deploy without the dev server (Vercel): the full backend URL and the same value as APP_SECRET.
# VITE_API_BASE=https://your-backend.example/v4
# VITE_APP_SECRET=
# Voice approval (ElevenLabs). `npm run voice:agent` at the repo root prints the id. Unset = no voice controls.
VITE_ELEVENLABS_AGENT_ID=
