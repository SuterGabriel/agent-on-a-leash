# Copy to .env.local to run against the backend in this repo (npm run api). Unset = mock data.
# The app talks to its own dev server; Vite forwards /v4 to the backend and adds APP_SECRET there (vite.config.ts),
# read from the repo's .env. The secret never reaches the browser.
VITE_API_BASE=/v4
# Where the backend runs (default http://localhost:8787).
# API_TARGET=http://localhost:8787
# Voice approval (ElevenLabs). `npm run voice:agent` at the repo root prints the id. Unset = no voice controls.
VITE_ELEVENLABS_AGENT_ID=
